datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

enum QuoteStatus {
  UPLOADED
  EXTRACTED
  LOCATED
  ESTIMATED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  SENT_TO_PARTNER
  CLOSED
  JUNK
}

model QuoteSession {
  id     String      @id @default(cuid())
  status QuoteStatus @default(UPLOADED)

  // Bill file (Vercel Blob)
  blobUrl      String?
  fileMimeType String?

  // Extracted from the bill (Mistral OCR -> GPT structured output).
  // We keep both the full address as printed (best free-text input for Google
  // Geocoding -> precise pin) and the coarse components (handy for Phase 4
  // country cost-defaults and Phase 5 lead filtering).
  kWhUsed              Float?
  billAmount           Float?
  currency             String? // ISO 4217 code as printed on the bill
  billingPeriodDays    Int?
  rawAddress           String? // full service address exactly as printed
  addressTown          String? // town / area / locality
  addressCity          String? // city
  addressState         String? // state / province / region
  addressCountry       String? // country
  utilityName          String?
  extractionConfidence Json? // per-field confidence scores
  ocrMarkdown          String? // raw Mistral OCR output, persisted so extraction can re-run without re-OCR

  // Location (Google Geocoding + user-confirmed pin)
  lat              Float?
  lng              Float?
  formattedAddress String?

  // Estimate results
  specificYield       Float? // kWh/kWp/yr from PVGIS or NASA POWER
  systemKwp           Float?
  annualProductionKwh Float?
  annualSavings       Float? // in the bill's own currency
  paybackYears        Float?
  estimateJson        Json? // full breakdown incl. 25-yr projection

  lead Lead?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// Solar irradiance (specific yield) cached by rounded lat/lng so nearby
// sessions share one upstream PVGIS/NASA call. The key is lat/lng rounded to
// 2 dp (~1.1 km) — fine for sizing, and far fewer distinct upstream requests.
model IrradianceCache {
  id            String   @id @default(cuid())
  latKey        Float // lat rounded to 2 dp (~1.1 km)
  lngKey        Float // lng rounded to 2 dp
  specificYield Float // kWh/kWp/yr
  source        String // "pvgis" | "nasa"
  raw           Json // upstream payload, for debugging
  createdAt     DateTime @default(now())

  @@unique([latKey, lngKey])
}

// --- Better Auth (admin dashboard) ---------------------------------------
// Standard Better Auth core schema (email/password, no plugins). Model names
// are the defaults the prisma adapter expects (user/session/account/
// verification); tables follow the rest of this schema's PascalCase convention.

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Lead {
  id               String     @id @default(cuid())
  name             String
  email            String
  phone            String?
  preferredContact String? // email | phone | whatsapp
  notes            String?
  status           LeadStatus @default(NEW)

  quoteSessionId String       @unique
  quoteSession   QuoteSession @relation(fields: [quoteSessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}
