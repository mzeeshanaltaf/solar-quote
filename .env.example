# Database — Neon Postgres. Use the POOLED connection string (host contains
# "-pooler") for serverless/Vercel. Get it from https://console.neon.tech
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Vercel Blob — stores uploaded bills (private)
BLOB_READ_WRITE_TOKEN=""
BLOB_STORE_ID=""                   # optional, if your setup requires it

# Bill extraction
MISTRAL_API_KEY=""                 # Mistral OCR — bill files to text
OPENAI_API_KEY=""                  # OpenAI — structured field extraction
OPENAI_EXTRACTION_MODEL=""         # optional override; defaults to gpt-5.4-mini
# Optional: set to "vision" to send the bill straight to the model in one call
# (no separate OCR step). Anything else (or unset) keeps OCR then extraction.
NEXT_PUBLIC_EXTRACTION_MODE="ocr"

# Google Maps
GOOGLE_MAPS_API_KEY=""             # server-side, Geocoding API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="" # browser, Maps JS + roof thumbnail — HTTP-referrer restricted
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""  # optional — vector map id for the marker (falls back to a demo map)

# Admin auth (dashboard at /admin)
BETTER_AUTH_SECRET=""              # min 32 chars; generate: openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"  # the app's base URL
# Seed-only: read by `npm run seed:admin` to create the single admin account.
# Public sign-up is disabled, so the dashboard only accepts a seeded account.
ADMIN_EMAIL="admin@solarquote.app"
ADMIN_PASSWORD=""                  # min 8 chars; change before seeding
ADMIN_NAME="SolarQuote Admin"

# Lead notifications — optional webhook pinged on new leads / contact messages
N8N_WEBHOOK_URL=""
N8N_API_KEY=""

# Rate limiting — optional Upstash Redis (fails open if unset)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
