# Neon Postgres — use the POOLED connection string (host contains "-pooler")
# for serverless/Vercel. Get it from https://console.neon.tech
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Vercel Blob (bill file storage) — Phase 2
BLOB_READ_WRITE_TOKEN=""
BLOB_STORE_ID="
"
# Extraction pipeline — Phase 2
MISTRAL_API_KEY=""
OPENAI_API_KEY=""
OPENAI_EXTRACTION_MODEL=""         # optional override; defaults to gpt-5.4-mini
# Funnel extraction path (experiment): "vision" sends the bill image/PDF straight
# to the model in one call (/api/extract-vision, no Mistral OCR). Anything else
# (or unset) keeps the upload → ocr → extract pipeline.
NEXT_PUBLIC_EXTRACTION_MODE="ocr"

# Google Maps — Phase 3
GOOGLE_MAPS_API_KEY="" # server-side, Geocoding API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="" # browser, Maps JS — HTTP-referrer restricted
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""  # optional, browser — vector map id for AdvancedMarker (falls back to DEMO_MAP_ID)

# Better Auth (admin dashboard) — Phase 5
BETTER_AUTH_SECRET=""                 # min 32 chars; generate: openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"
# Seed the single admin account: `npm run seed:admin` reads these. Public
# sign-up is disabled, so the dashboard login only accepts a seeded account.
ADMIN_EMAIL="admin@solarquote.app"
ADMIN_PASSWORD=""                     # min 8 chars; change before seeding
ADMIN_NAME="SolarQuote Admin"

N8N_WEBHOOK_URL=
N8N_API_KEY=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
