# Public site URL — the canonical origin used to resolve Open Graph, Twitter,
# and canonical link tags (see metadataBase in app/layout.tsx). MUST be set in
# production or share previews/canonical URLs fall back to http://localhost:3000.
# No trailing slash. e.g. https://solarquote.zeeshanai.cloud
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Database — Neon Postgres. Use the POOLED connection string (host contains
# "-pooler"). Get it from https://console.neon.tech
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Object storage — S3-compatible (self-hosted MinIO on Coolify). Stores uploaded
# bills privately; the app reads/writes bytes server-side only. Server-side vars
# (runtime), not build-time.
S3_ENDPOINT="http://minio:9000"    # MinIO S3 API URL (internal host in prod)
S3_BUCKET="bills"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="us-east-1"              # MinIO ignores region but the SDK requires one
S3_FORCE_PATH_STYLE="true"         # MinIO serves buckets path-style

# Bill extraction
MISTRAL_API_KEY=""                 # Mistral OCR — bill files to text
OPENAI_API_KEY=""                  # OpenAI — structured field extraction
OPENAI_EXTRACTION_MODEL=""         # optional override; defaults to gpt-5.4-mini
# Optional: set to "vision" to send the bill straight to the model in one call
# (no separate OCR step). Anything else (or unset) keeps OCR then extraction.
NEXT_PUBLIC_EXTRACTION_MODE="ocr"

# Google Maps
GOOGLE_MAPS_API_KEY=""             # server-side, Geocoding API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="" # browser, Maps JS + roof thumbnail — HTTP-referrer restricted
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""  # optional — vector map id for the marker (falls back to a demo map)

# Admin auth (dashboard at /admin)
BETTER_AUTH_SECRET=""              # min 32 chars; generate: openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"  # the app's base URL
# Seed-only: read by `npm run seed:admin` to create the single admin account.
# Public sign-up is disabled, so the dashboard only accepts a seeded account.
ADMIN_EMAIL="admin@solarquote.app"
ADMIN_PASSWORD=""                  # min 8 chars; change before seeding
ADMIN_NAME="SolarQuote Admin"

# Lead notifications — optional webhook pinged on new leads / contact messages
N8N_CONTACT_WEBHOOK_URL=""
N8N_LEAD_WEBHOOK_URL=""
N8N_API_KEY=""

# Rate limiting — optional Upstash Redis (fails open if unset)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Umami analytics (self-hosted, cookieless). Both are NEXT_PUBLIC_* so they must
# be present at BUILD time — the tracker only renders when both are set.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=""     # https://<your-umami-host>/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""     # website UUID from the Umami dashboard
